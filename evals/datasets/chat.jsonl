// Chat cases. "seed" memories are stored for the case's user before the first turn.
{"id": "time-chicago", "input": "What time is it in Chicago right now?", "checks": {"tool_called": "now"}, "criteria": ["correct", "honest_tools"], "expect": "Calls the time tool with America/Chicago and reports that time.", "tags": ["tools"], "reviewed": "2026-10-07"}
{"id": "arithmetic", "input": "What is 1240 * 0.87 + 12?", "checks": {"tool_called": "calculate", "reply_mentions": "1090.8"}, "criteria": ["correct", "honest_tools"], "expect": "1090.8, computed with the calculator.", "tags": ["tools"], "reviewed": "2026-10-07"}
{"id": "definition-no-tools", "input": "In one sentence, what is a hash map?", "checks": {"no_tools": true}, "criteria": ["correct"], "expect": "A one-sentence definition: a structure mapping keys to values via a hash function for average constant-time lookup.", "tags": ["no-tools"], "reviewed": "2026-10-07"}
{"id": "remember-preference", "input": "I prefer metric units. Please remember that.", "checks": {"remembered": "metric"}, "criteria": ["correct"], "expect": "Stores the preference with remember() and confirms briefly.", "tags": ["memory"], "reviewed": "2026-10-07"}
{"id": "use-seeded-preference", "input": "How tall is Mount Everest?", "seed": ["prefers metric units"], "checks": {"recalled": "metric"}, "criteria": ["correct", "uses_memory"], "expect": "About 8,849 metres, given in metric because of the stored preference.", "tags": ["memory"], "reviewed": "2026-10-07"}
{"id": "ignore-irrelevant-memory", "input": "What is the capital of Australia?", "seed": ["drinks tea every morning"], "checks": {"reply_mentions": "Canberra", "reply_excludes": "tea"}, "criteria": ["correct", "uses_memory"], "expect": "Canberra, with no mention of the unrelated memory.", "tags": ["memory"], "reviewed": "2026-10-07"}
{"id": "multi-turn-timezone", "input": ["My name is Sam and I live in Dallas.", "What time zone am I in?"], "checks": {"reply_mentions": "Central"}, "criteria": ["correct"], "expect": "Central Time (America/Chicago), using what was said earlier in the conversation.", "tags": ["multi-turn"], "reviewed": "2026-10-07"}
{"id": "transient-not-remembered", "input": "What is 15% of 80?", "checks": {"tool_not_called": "remember", "reply_mentions": "12"}, "criteria": ["correct", "honest_tools"], "expect": "12. A one-off question is not stored as a memory.", "tags": ["memory", "tools"], "reviewed": "2026-10-07"}
{"id": "remember-date", "input": "Remember that my sister's birthday is March 3.", "checks": {"remembered": "March 3"}, "criteria": ["correct"], "expect": "Stores the birthday with remember() and confirms.", "tags": ["memory"], "reviewed": "2026-10-07"}
{"id": "todays-date", "input": "What's today's date?", "checks": {"tool_called": "now"}, "criteria": ["correct", "honest_tools"], "expect": "Calls the time tool and reports the date it returned.", "tags": ["tools"], "reviewed": "2026-10-07"}
{"id": "recall-stated-fact", "input": "Which programming language did I say I'm learning?", "seed": ["is learning Rust"], "checks": {"recalled": "Rust", "reply_mentions": "Rust"}, "criteria": ["correct", "uses_memory"], "expect": "Rust, from the stored memory.", "tags": ["memory"], "reviewed": "2026-10-07"}
{"id": "unknown-fact-not-invented", "input": "What did I tell you my favourite colour is?", "criteria": ["correct", "honest_tools"], "expect": "Says it does not know or has nothing stored; does not invent a colour.", "tags": ["memory", "honesty"], "reviewed": "2026-10-07"}
