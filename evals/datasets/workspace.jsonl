// Workspace cases (docs/design/tools.md). "corpus" selects that pinned corpus for the thread; "seed" memories are stored for the case's user first.
{"id": "docs-stream-recovery", "input": "How does Waypoint recover when a client's event stream drops in the middle of a run?", "corpus": "waypoint-docs", "checks": {"tool_called": "search_documents", "citations_resolve": true, "claims_cited": true, "cites_documents": true}, "criteria": ["correct", "grounded"], "expect": "Run events live in a Redis Stream with monotonic ids; the client reconnects with Last-Event-ID and the server replays from there, so nothing is lost or repeated; a dropped stream is not a failed run; the Redis socket timeout must outlast the XREAD block.", "tags": ["documents"], "reviewed": "2026-10-13"}
{"id": "docs-tenant-isolation", "input": "How does Waypoint keep one tenant's data and runs away from another tenant?", "corpus": "waypoint-docs", "checks": {"tool_called": "search_documents", "citations_resolve": true, "claims_cited": true, "cites_documents": true}, "criteria": ["correct", "grounded"], "expect": "A threads table records ownership and another tenant's thread is a 404, not a 403; identity lives in the runtime context, not in state; memories are namespaced per tenant and user; node cache keys carry the tenant id; limits are per tenant; corpora are protected by row-level security.", "tags": ["documents"], "reviewed": "2026-10-13"}
{"id": "docs-eval-costs", "input": "How does Waypoint keep the cost of its agent evaluations down?", "corpus": "waypoint-docs", "checks": {"tool_called": "search_documents", "citations_resolve": true, "claims_cited": true, "cites_documents": true}, "criteria": ["correct", "grounded"], "expect": "A cheaper searcher model, at most two web searches per worker call, record and replay of model calls so a change pays only for what it changed, one trial to iterate and three only to accept, and judge models routed per criterion.", "tags": ["documents"], "reviewed": "2026-10-13"}
{"id": "docs-follow-up", "input": ["How does Waypoint resume a dropped event stream?", "How long does a finished run's stream stay readable?"], "corpus": "waypoint-docs", "checks": {"tool_called": "search_documents", "citations_resolve": true, "cites_documents": true, "reply_mentions": "3600"}, "criteria": ["correct", "grounded"], "expect": "Second answer: STREAM__TTL_S, 3600 seconds (one hour) by default, after which a finished run's events are retired. Uses the thread's documents on both turns.", "tags": ["documents", "multi-turn"], "reviewed": "2026-10-13"}
{"id": "docs-not-covered", "input": "Which GPU does Waypoint need to train its own models?", "corpus": "waypoint-docs", "checks": {"tool_called": "search_documents"}, "criteria": ["correct", "honest_tools"], "expect": "Says the documents do not cover this; Waypoint calls hosted models rather than training its own. Does not invent a GPU or a requirement.", "tags": ["documents", "honesty"], "reviewed": "2026-10-13"}
{"id": "docs-off-topic", "input": "What is the capital of Australia?", "corpus": "waypoint-docs", "checks": {"reply_mentions": "Canberra"}, "criteria": ["correct"], "expect": "Canberra. The selected documents are not needed for this.", "tags": ["documents", "no-documents-needed"], "reviewed": "2026-10-13"}
{"id": "docs-with-memory", "input": "How are my memories kept away from other tenants?", "corpus": "waypoint-docs", "seed": ["wants answers in one short paragraph"], "checks": {"tool_called": "search_documents", "cites_documents": true, "recalled": "short paragraph"}, "criteria": ["correct", "grounded", "uses_memory"], "expect": "One short paragraph: memory namespaces derive from the run's context, per tenant and user, never from state, so one tenant's memories never reach another's.", "tags": ["documents", "memory"], "reviewed": "2026-10-13"}
{"id": "arithmetic", "input": "What is 1240 * 0.87 + 12?", "checks": {"tool_called": "calculate", "reply_mentions": "1090.8"}, "criteria": ["correct", "honest_tools"], "expect": "1090.8, computed with the calculator.", "tags": ["tools"], "reviewed": "2026-10-13"}
{"id": "remember-preference", "input": "I prefer metric units. Please remember that.", "checks": {"remembered": "metric"}, "criteria": ["correct"], "expect": "Stores the preference with remember() and confirms briefly.", "tags": ["memory"], "reviewed": "2026-10-13"}
{"id": "use-seeded-preference", "input": "How tall is Mount Everest?", "seed": ["prefers metric units"], "checks": {"recalled": "metric"}, "criteria": ["correct", "uses_memory"], "expect": "About 8,849 metres, given in metric because of the stored preference. No documents are selected, so no search.", "tags": ["memory"], "reviewed": "2026-10-13"}
