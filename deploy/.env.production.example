# Production settings for a public demo. Copy to .env in the repository root
# on the server (cp deploy/.env.production.example .env) and fill in the blanks.
# docs/DEPLOY.md walks through it. Never commit the filled-in file.

# ------------------------------------------------------------- secrets ------
# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
SECRET_KEY=

# A key from a dedicated Anthropic Console workspace with a monthly spend
# limit. The limit is the hard cap on what a public demo can cost you.
ANTHROPIC_API_KEY=

# Set for the first boot only, to mint real keys; then remove it and revoke it
# (DEPLOY.md, "API keys"). Generate with:
#   python3 -c "import secrets; print(f'ak_{secrets.token_hex(6)}.{secrets.token_urlsafe(32)}')"
BOOTSTRAP_API_KEY=

# --------------------------------------------------------------- host -------
# Makes plain `docker compose ...` use the production overrides too.
COMPOSE_FILE=compose.yaml:compose.prod.yaml
# Loopback port Caddy proxies to. One per demo on a shared host.
WEB_PORT=8080
CORS_ORIGINS=https://waypoint.brentdunham.com

# -------------------------------------------------------------- models ------
MODEL=claude-sonnet-5
MODELS__RESEARCH__SEARCHER=claude-haiku-5-5
MODELS__RESEARCH__VERIFIER=claude-haiku-5-5
# What a run request may choose. Empty means the models named above.
MODELS_ALLOWED=

# -------------------------------------------------------------- limits ------
# Per tenant. Every demo visitor shares the demo key's tenant, so these are
# the limits for all visitors together.
LIMITS__RPM=10
LIMITS__CONCURRENT_RUNS=2
LIMITS__RUN_TIMEOUT_S=300

# ------------------------------------------------------------- tracing ------
# compose.prod.yaml runs Jaeger (traces kept 7 days) and sends it every run's
# trace. TRACING__PANEL=true shows reviewers their own runs' timelines in the
# app. Jaeger's own UI stays private: ssh -L 16686:127.0.0.1:16686 bob
TRACING__PANEL=true

# ------------------------------------------------------------- budgets ------
# Daily spending caps in US dollars, enforced before each run starts (a run
# already going finishes). compose.prod.yaml refuses to start without them.
# 0.70 a day caps any 30 days at about $21; 0.35 is about one research run
# per reviewer a day. Exempt your own tenant with null, or raise one:
#   BUDGET__TENANTS='{"your-tenant": null, "acme": 2.0}'   (single quotes: JSON)
# Your tenant: select distinct tenant_id from api_keys where revoked_at is null and ('*' = any(scopes) or 'keys:admin' = any(scopes))
BUDGET__TENANT_USD_PER_DAY=0.35
BUDGET__GLOBAL_USD_PER_DAY=0.70
BUDGET__TENANTS=

# ------------------------------------------------------- research agent -----
# About $0.15 per research run with these models and bounds, web searches
# included (eval run 2026-10-12; docs/case-studies/cost.md). MAX_ROUNDS=2
# adds critic follow-ups for about $0.24 per run.
RESEARCH__WEB_SEARCH=true
RESEARCH__MAX_SEARCHES=2
RESEARCH__MAX_ROUNDS=1
RESEARCH__MAX_FOLLOW_UPS=3
RESEARCH__VERIFY_CITATIONS=true

# ------------------------------------------------- documents (RAG) ----------
# The public waypoint-docs corpus: this repository's docs/, indexed at every
# boot (only changed pages are re-embedded) and searchable by every key.
# Reviewer keys cannot upload (no corpora:write scope). Embedding all of docs/
# is about 60k tokens, inside Voyage's free tier; reranking is about $0.0007
# per research question. Key from https://dashboard.voyageai.com/
RAG__EMBEDDINGS_MODEL=voyageai:voyage-4
RAG__EMBEDDINGS_DIMS=1024
VOYAGE_API_KEY=
RAG__SEED_DIR=docs

# ------------------------------------------------------------- memory -------
# Unset: chat memory works without semantic search. Set both to enable it.
EMBEDDINGS_MODEL=
OPENAI_API_KEY=
