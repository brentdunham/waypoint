# Production settings for a public demo. Copy to .env in the repository root
# on the server (cp deploy/production.env.example .env) and fill in the blanks.
# docs/DEPLOY.md walks through it. Never commit the filled-in file.

# ------------------------------------------------------------- secrets ------
# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
SECRET_KEY=

# A key from a dedicated Anthropic Console workspace with a monthly spend
# limit. The limit is the hard cap on what a public demo can cost you.
ANTHROPIC_API_KEY=

# Set for the first boot only, to mint real keys; then remove it and revoke it
# (DEPLOY.md, "API keys"). Generate with:
#   python3 -c "import secrets; print(f'ak_{secrets.token_hex(6)}.{secrets.token_urlsafe(32)}')"
BOOTSTRAP_API_KEY=

# --------------------------------------------------------------- host -------
# Makes plain `docker compose ...` use the production overrides too.
COMPOSE_FILE=compose.yaml:compose.prod.yaml
# Loopback port Caddy proxies to. One per demo on a shared host.
WEB_PORT=8080
CORS_ORIGINS=https://waypoint.brentdunham.com

# -------------------------------------------------------------- models ------
MODEL=claude-sonnet-5
MODELS__RESEARCH__SEARCHER=claude-haiku-5-5
MODELS__RESEARCH__VERIFIER=claude-haiku-5-5
# What a run request may choose. Empty means the models named above.
MODELS_ALLOWED=

# -------------------------------------------------------------- limits ------
# Per tenant. Every demo visitor shares the demo key's tenant, so these are
# the limits for all visitors together.
LIMITS__RPM=10
LIMITS__CONCURRENT_RUNS=2
LIMITS__RUN_TIMEOUT_S=300

# ------------------------------------------------------- research agent -----
# About $0.27 per research run with these models and bounds (fresh eval run,
# 2026-10-09), plus web searches at $0.01 each. Lower MAX_ROUNDS to 1 to cut
# follow-up searches.
RESEARCH__WEB_SEARCH=true
RESEARCH__MAX_SEARCHES=2
RESEARCH__MAX_ROUNDS=2
RESEARCH__MAX_FOLLOW_UPS=3
RESEARCH__VERIFY_CITATIONS=true

# ------------------------------------------------------------- memory -------
# Unset: chat memory works without semantic search. Set both to enable it.
EMBEDDINGS_MODEL=
OPENAI_API_KEY=
