# ---------------------------------------------------------------- app -------
ENV=development                 # development | production | test
DEBUG=true
SECRET_KEY=change-me            # reserved for sessions; unused today. python -c "import secrets;print(secrets.token_urlsafe(32))"
LOG_LEVEL=INFO
JSON_LOGS=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------------------------------------------------------------- auth ------
AUTH_ENABLED=true
# Seeded on boot as tenant/user "bootstrap" with all scopes, so you have one key
# to mint the others with. Deliberately blank: a key printed in this file would
# be a full-access credential that everyone who reads the repo already knows.
# Generate your own, then use it once via POST /api/v1/keys and unset it:
#   python -c "import secrets; print(f'ak_{secrets.token_hex(6)}.{secrets.token_urlsafe(32)}')"
BOOTSTRAP_API_KEY=

# ---------------------------------------------------------------- model -----
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5
MAX_TOKENS=4096
# Deliberately unset: newer Anthropic models reject `temperature` with a 400,
# and on older ones the default is already 0. Set it only if you want variety.
# MODEL_TEMPERATURE=0.7
# A model per agent and role (docs/CONFIGURATION.md). Unset -> MODEL.
# MODELS__RESEARCH__DEFAULT=
# MODELS__RESEARCH__CRITIC=
# The searcher reads every search result as input, so it is most of a research
# run's tokens. Haiku 5.5 costs a twentieth of Sonnet 5 per token.
MODELS__RESEARCH__SEARCHER=claude-haiku-5-5
# The verifier checks each briefing sentence against the source quotes; a
# classification over short quotes, so Haiku is enough. Sentences it finds
# unsupported go back to the writer's model.
MODELS__RESEARCH__VERIFIER=claude-haiku-5-5
# MODELS__CHAT__ASSISTANT=
# The workspace agent's verifier: the same job as research's, so the same model.
MODELS__WORKSPACE__VERIFIER=claude-haiku-5-5
# MODELS__WORKSPACE__ASSISTANT=
# MODELS_ALLOWED=               # comma list a run may choose; empty = every model named above
FAKE_MODEL=false                # true -> deterministic offline stub, no API calls

# ------------------------------------------------------- infrastructure -----
DATABASE_URL=postgresql://waypoint:waypoint@localhost:5432/waypoint
REDIS_URL=redis://localhost:6379/0
# REDIS_SOCKET_TIMEOUT_S=30     # must exceed STREAM__BLOCK_MS by 1s or more
DB_POOL_MIN=1
DB_POOL_MAX=10

# ------------------------------------------------------- long-term memory ---
# Unset -> the store works but without vector search. Set -> needs pgvector
# (the compose images already have it). openai: also needs OPENAI_API_KEY.
# EMBEDDINGS_MODEL=openai:text-embedding-3-small
# EMBEDDINGS_DIMS=1536
# OPENAI_API_KEY=

# ------------------------------------------- document retrieval (RAG) ---
# Unset -> /corpora answers 503. The chosen model is voyage-4 at 1024 dims
# (docs/CONFIGURATION.md says why). voyageai: needs VOYAGE_API_KEY.
# RAG__EMBEDDINGS_MODEL=voyageai:voyage-4
# RAG__EMBEDDINGS_DIMS=1024
# VOYAGE_API_KEY=
# Reranking with Voyage rerank-3 is on by default and uses the same key;
# RAG__RERANK=false turns it off. Contextual retrieval is off (it did not
# earn its place in the phase 4 retrieval eval); RAG__CONTEXTUAL=true.
# RAG__RERANK=true
# RAG__CONTEXTUAL=false

# --------------------------------------------------------- research agent ---
# Web search must be enabled for your org in the Claude Console.
RESEARCH__WEB_SEARCH=true
RESEARCH__MAX_SEARCHES=2        # per worker call; each search is re-read by the next
RESEARCH__MAX_ROUNDS=1          # investigation waves; 2 adds critic follow-ups
RESEARCH__MAX_FOLLOW_UPS=3      # new questions per round
RESEARCH__VERIFY_CITATIONS=true # check every sentence's [n] against the source quotes

# -------------------------------------------------------- workspace agent ---
# Check every workspace reply that cites documents, with the research verifier.
WORKSPACE__VERIFY_CITATIONS=true

# ---------------------------------------------------------------- caching ---
NODE_CACHE_TTL_S=300            # 0 disables the Redis node cache

# ---------------------------------------------------------------- limits ----
LIMITS__RPM=60
LIMITS__CONCURRENT_RUNS=4
LIMITS__MAX_INPUT_CHARS=100000
LIMITS__RECURSION_LIMIT=40
LIMITS__RUN_TIMEOUT_S=300

# ---------------------------------------------------------- upload limits ---
# Per tenant per UTC day, for keys with corpora:write but not keys:admin.
UPLOADS__MAX_CORPORA=3
UPLOADS__FILES_PER_DAY=10
UPLOADS__MB_PER_DAY=5.0
UPLOADS__CHUNKS_PER_DAY=2000

# ---------------------------------------------------------------- budgets ---
# Daily US dollar caps (docs/CONFIGURATION.md, Budgets). Off when unset here;
# production requires them. Needs REDIS_URL.
# BUDGET__TENANT_USD_PER_DAY=0.35
# BUDGET__GLOBAL_USD_PER_DAY=0.70
# BUDGET__TENANTS='{"local": null}'

# ---------------------------------------------------------------- streams ---
STREAM__MAXLEN=2000             # events retained per run
STREAM__TTL_S=3600              # how long a finished run stays replayable
STREAM__HEARTBEAT_S=15
STREAM__BLOCK_MS=5000

# ---------------------------------------------------------------- tracing ---
# OpenTelemetry: unset means off. With compose.dev.yaml's Jaeger:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# TRACING__CONTENT=false         # true puts prompts on spans: local debugging only
# TRACING__PANEL=true            # the in-app run timeline; needs the query URL:
# TRACING__QUERY_URL=http://localhost:16686
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=waypoint
# LANGSMITH_API_KEY=

# ------------------------------------------------------------------ tests ---
# TEST_DATABASE_URL=postgresql://waypoint:waypoint@localhost:5432/waypoint_test
# TEST_REDIS_URL=redis://localhost:6379/15

# Evals (python -m evals only). The judge defaults to the cheapest Claude model.
# EVALS__JUDGE_MODEL=claude-haiku-4-5
# EVALS__JUDGE_ESCALATION_MODEL=
# EVALS__JUDGE_TEMPERATURE=0
# EVALS__MIN_AGREEMENT=0.8
# Retrieval eval index; a database of its own (createdb waypoint_evals).
# EVALS__DATABASE_URL=postgresql://waypoint:waypoint@localhost:5432/waypoint_evals
